{
  "expo": {
    "name": "Checador",
    "slug": "checador-movil",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#FFFFFF"
    },
    "android": {
      "package": "com.checador.app",
      "usesCleartextTraffic": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "./plugins/withCleartextTraffic",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permitir a Checador conocer tu ubicación para registrar entrada y salida del centro de trabajo."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Checador usa reconocimiento facial para verificar tu identidad."
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://192.168.137.1:8000/api/v1",
      "eas": {
        "projectId": "40ba173f-ec1d-497f-a3e3-dcc066df8a79"
      }
    },
    "owner": "ecastillo-123"
  }
}
